       RowBox[{"rispettivamente", " ", "lungo", " ", "x"}], ",", "y", ",", 
       "z"}], ")"}], " ", "del", " ", "plot"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"soSferico", "[", 
    RowBox[{"l1_", ",", "l2_", ",", "dimX_", ",", "dimY_", ",", "dimZ_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "plot", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"l1", ",", "l2", ",", "dimX", ",", "dimY", ",", "dimZ"}], 
           "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
            RowBox[{"!", 
             RowBox[{"parteComplessa", "[", "#", "]"}]}]}], "&"}]}], "]"}], "&&", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"dimX", ",", "dimY", ",", "dimZ"}], "}"}], ",", 
          "Positive"}], "]"}]}], ",", "\[IndentingNewLine]", 
