          RowBox[{"q3", " ", 
           RowBox[{"Cos", "[", "q2", "]"}]}], "+", 
          RowBox[{"l2", " ", 
           RowBox[{"Sin", "[", "q2", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"list", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x1", ",", "y1", ",", "z1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x2", ",", "y2", ",", "z2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x3", ",", "y3", ",", "z3"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"plot", " ", "=", " ", 
