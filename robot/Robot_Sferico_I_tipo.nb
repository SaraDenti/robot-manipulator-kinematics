             "dimY", ",", "dimZ"}], 
           StyleBox["}",
            FontSize->14]}], 
          StyleBox[",",
           FontSize->14], 
          StyleBox[
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
