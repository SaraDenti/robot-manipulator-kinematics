         FontSize->14]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x1", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"y1", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"z1", "=", "l1"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"x2", "=", 
         RowBox[{"l2", " ", 
          RowBox[{"Cos", "[", "q1", "]"}], " ", 
          RowBox[{"Cos", "[", "q2", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"y2", "=", 
         RowBox[{"l2", " ", 
          RowBox[{"Cos", "[", "q2", "]"}], " ", 
          RowBox[{"Sin", "[", "q1", "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"z2", "=", 
