Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "Questa", " ", "procedura", " ", "calcola", " ", "le", " ", "variabili",
        " ", "di", " ", "giunto", " ", "corrispondenti", " ", "alla", " ", 
       "posizione", " ", "dell"}], "\[CloseCurlyQuote]"}], "end", " ", 
     "effector", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}], " ", "fornita", " ", "in", " ", 
     RowBox[{"ingresso", ".", "\[IndentingNewLine]", "I"}], " ", "parametri", 
     " ", "l1", " ", "e", " ", "l2", " ", "rappresentano", " ", "le", " ", 
     "lunghezze", " ", "dei", " ", "segmenti", " ", 
     SubscriptBox["L", "1"], " ", "e", " ", 
     SubscriptBox["L", "2"], " ", "del", " ", "robot"}], ",", 
    RowBox[{"mentre", " ", "g2", " ", "e", " ", "g3"}], ",", " ", 
    RowBox[{
     RowBox[{"pari", " ", "a"}], " ", "\[PlusMinus]", "1"}], ",", " ", 
    RowBox[{
    "permettono", " ", "di", " ", "scegliere", " ", "una", " ", "tra", " ", 
     "le", " ", "diverse", " ", "configurazioni", " ", "ammissibili"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{"cinInversaSferico", "[", 
    RowBox[{
    "x_", ",", "y_", ",", "z_", ",", "l1_", ",", "l2_", ",", "g2_", ",", 
     "g3_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "q1", ",", "q2", ",", "q3", ",", "c1", ",", "s1", ",", "c2", ",", 
       "s2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z", ",", "l1", ",", "l2"}], "}"}], ",",
           "numeroReale"}], "]"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g2", "===", "1"}], " ", "||", " ", 
          RowBox[{"g2", "===", 
           RowBox[{"-", "1"}]}]}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g3", "===", "1"}], " ", "||", " ", 
          RowBox[{"g3", "===", 
           RowBox[{"-", "1"}]}]}], ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"Refine", "[", 
           RowBox[{
            RowBox[{"FullSimplify", "[", 
             RowBox[{
              SuperscriptBox["x", "2"], "+", 
              SuperscriptBox["y", "2"], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"z", "-", "l1"}], ")"}], "2"], "-", 
              SuperscriptBox["l2", "2"]}], "]"}], ">=", "0"}], "]"}], "]"}], ",",
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"q3", "=", 
           RowBox[{
            RowBox[{"g3", 
             SqrtBox[
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["l2", "2"]}], "+", 
               SuperscriptBox["x", "2"], "+", 
               SuperscriptBox["y", "2"], "+", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"l1", "-", "z"}], ")"}], "2"]}]]}], "//", 
            "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
