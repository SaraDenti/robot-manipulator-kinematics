Cell[CellGroupData[{

Cell["Procedura", "Subsection",
 CellChangeTimes->{{3.9792792572814407`*^9, 
  3.97927925955287*^9}},ExpressionUUID->"d409a6ba-710b-d840-a461-\
29a4362b6e89"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "Questa", " ", "procedura", " ", "calcola", " ", "le", " ", "variabili",
        " ", "di", " ", "giunto", " ", "corrispondenti", " ", "alla", " ", 
       "posizione", " ", "dell"}], "\[CloseCurlyQuote]"}], "end", " ", 
     "effector", " ", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y", ",", "z"}], ")"}], " ", "fornita", " ", "in", " ", 
     RowBox[{"ingresso", ".", "I"}], " ", "parametri", " ", "l1", " ", "e", " ",
      "l2", " ", "rappresentano", " ", "le", " ", "lunghezze", " ", "dei", " ",
      "segmenti", " ", "del", " ", "manipolatore"}], ",", 
    RowBox[{"mentre", " ", "g2", " ", "e", " ", "g3"}], ",", " ", 
    RowBox[{
     RowBox[{"pari", " ", "a"}], " ", "\[PlusMinus]", "1"}], ",", " ", 
    RowBox[{
    "permettono", " ", "di", " ", "scegliere", " ", "una", " ", "tra", " ", 
     "le", " ", "diverse", " ", "configurazioni", " ", "ammissibili"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{"cinInversaStandford", "[", 
    RowBox[{
    "x_", ",", "y_", ",", "z_", ",", "l1_", ",", "l2_", ",", "g2_", ",", 
     "g3_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "q1", ",", "q2", ",", "q3", ",", "s1", ",", "c1", ",", "s2", ",", 
       "c2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z", ",", "l1", ",", "l2"}], "}"}], ",",
           "numeroReale"}], "]"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g2", "===", 
           RowBox[{"-", "1"}]}], " ", "||", " ", 
          RowBox[{"g2", "===", 
           RowBox[{"+", "1"}]}]}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"g3", "===", 
           RowBox[{"-", "1"}]}], " ", "||", " ", 
          RowBox[{"g3", "===", 
           RowBox[{"+", "1"}]}]}], ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"Refine", "[", 
           RowBox[{
            RowBox[{"FullSimplify", "[", 
             RowBox[{
              SuperscriptBox["x", "2"], "+", 
              SuperscriptBox["y", "2"], "-", 
              SuperscriptBox["l2", "2"]}], "]"}], "\[GreaterEqual]", "0"}], 
           "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"q3", "=", 
           RowBox[{
            RowBox[{"g3", 
             SqrtBox[
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["l2", "2"]}], "+", 
               SuperscriptBox["x", "2"], "+", 
               SuperscriptBox["y", "2"], "+", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"l1", "-", "z"}], ")"}], "2"]}]]}], "//", 
            "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"N", "[", "q3", "]"}], "=!=", "0."}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"s2", "=", 
              RowBox[{
               FractionBox[
                RowBox[{"g2", 
                 SqrtBox[
                  RowBox[{
                   RowBox[{"-", 
                    SuperscriptBox["l2", "2"]}], "+", 
                   SuperscriptBox["x", "2"], "+", 
                   SuperscriptBox["y", "2"]}]]}], "q3"], "//", 
               "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"c2", "=", 
              FractionBox[
               RowBox[{
                RowBox[{"-", "l1"}], "+", "z"}], "q3"]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"q2", "=", 
              RowBox[{
               RowBox[{"ArcTan", "[", 
                RowBox[{"c2", ",", "s2"}], "]"}], "//", "FullSimplify"}]}], 
             ";"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q2", "=", "0"}], ";"}]}], 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Se", " ", 
              SubscriptBox["q", "3"]}], "===", 
             RowBox[{"0", " ", "q2", " ", "\[EGrave]", " ", "arbitrario"}]}], 
            "*)"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"FullSimplify", "[", 
               RowBox[{
                SuperscriptBox["l2", "2"], "+", 
                RowBox[{
                 SuperscriptBox["q3", "2"], " ", 
                 SuperscriptBox["s2", "2"]}]}], "]"}], "]"}], "=!=", "0."}], ",",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"s1", "=", 
              FractionBox[
               RowBox[{
                RowBox[{
                 RowBox[{"-", "l2"}], " ", "x"}], "+", 
                RowBox[{"q3", " ", "s2", " ", "y"}]}], 
               RowBox[{
                SuperscriptBox["l2", "2"], "+", 
                RowBox[{
                 SuperscriptBox["q3", "2"], " ", 
                 SuperscriptBox["s2", "2"]}]}]]}], ";", "\[IndentingNewLine]", 
             RowBox[{"c1", "=", 
              FractionBox[
               RowBox[{
                RowBox[{"q3", " ", "s2", " ", "x"}], "+", 
                RowBox[{"l2", " ", "y"}]}], 
               RowBox[{
                SuperscriptBox["l2", "2"], "+", 
                RowBox[{
                 SuperscriptBox["q3", "2"], " ", 
                 SuperscriptBox["s2", "2"]}]}]]}], ";", "\[IndentingNewLine]", 
             RowBox[{"q1", "=", 
              RowBox[{
               RowBox[{"ArcTan", "[", 
                RowBox[{"c1", ",", "s1"}], "]"}], "//", "FullSimplify"}]}], 
             ";"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q1", "=", "0"}], ";"}]}], 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{"Se", " ", 
               SuperscriptBox["l2", "2"]}], "+", 
              RowBox[{
               SuperscriptBox["q3", "2"], " ", 
               SuperscriptBox["s2", "2"]}]}], "===", 
             RowBox[{"0", " ", "q1", " ", "\[EGrave]", " ", "arbitrario"}]}], 
            "*)"}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Echo", "[", 
           RowBox[{
            RowBox[{"{", "}"}], 
            ",", "\"\<Il punto non rientra all'interno dello spazio operativo\
\>\""}], "]"}], ";"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Echo", "[", "\"\<Argomenti non validi\>\"", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}], "]"}]}]}]], "Input",
