Cell[CellGroupData[{

Cell["Animazione", "Subtitle",
 CellChangeTimes->{{3.97980354702666*^9, 
  3.979803548527116*^9}},ExpressionUUID->"040801ba-9bd5-475f-b2c2-\
74032b0279ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Questa", " ", "procedura", " ", "realizza", " ", "l"}], 
      "\[CloseCurlyQuote]"}], "animazione", " ", "di", " ", "un", " ", 
     "robot", " ", "antropomorfo", " ", "che", " ", "segue", " ", "una", " ", 
     "traiettoria", " ", "nello", " ", "spazio", " ", "descritta", " ", 
     "dalle", " ", "funzioni", " ", "px"}], ",", 
    RowBox[{"py", " ", "e", " ", 
     RowBox[{"pz", ".", " ", "I"}], " ", "parametri", " ", "l1"}], ",", 
    RowBox[{
    "l2", " ", "e", " ", "l3", " ", "rappresentano", " ", "le", " ", 
     "lunghezze", " ", "del", " ", 
     RowBox[{"robot", ".", " ", "\[IndentingNewLine]", "N", ".", 
      RowBox[{"B", ":", " ", 
       RowBox[{
       "Tale", " ", "procedura", " ", "non", " ", "controlla", " ", "gli", " ",
         "argomenti", " ", "passati", " ", "in", " ", "ingresso"}]}]}]}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"animazioneAntropomorfo", "[", 
    RowBox[{
    "px_", ",", "py_", ",", "pz_", ",", "l1_", ",", "l2_", ",", "l3_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "q1", ",", "q2", ",", "q3", ",", "p1", ",", "p2", ",", "p3", ",", 
       "rr"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rr", "=", 
       RowBox[{
        RowBox[{"Abs", "[", "l2", "]"}], "+", 
        RowBox[{"Abs", "[", "l3", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"p3", "=", 
       RowBox[{"soAntropomorfo", "[", 
        RowBox[{"l1", ",", "l2", ",", "l3", ",", "rr", ",", "rr", ",", "rr"}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Animate", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], "=", 
          RowBox[{"cinInversaAntro", "[", 
           RowBox[{
            RowBox[{"px", "[", "t", "]"}], ",", 
            RowBox[{"py", "[", "t", "]"}], ",", 
            RowBox[{"pz", "[", "t", "]"}], ",", "l1", ",", "l2", ",", "l3", ",", 
            RowBox[{"+", "1"}], ",", 
            RowBox[{"+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"p1", "=", 
          RowBox[{"robotAntropomorfo", "[", 
           RowBox[{
           "q1", ",", "q2", ",", "q3", ",", "l1", ",", "l2", ",", "l3", ",", 
            "rr", ",", "rr", ",", "rr"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"p2", "=", 
          RowBox[{"ListPointPlot3D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"px", "[", "t", "]"}], ",", 
               RowBox[{"py", "[", "t", "]"}], ",", 
               RowBox[{"pz", "[", "t", "]"}]}], "}"}], "}"}], ",", 
            RowBox[{"PlotStyle", "->", "Green"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{"p1", ",", "p2", ",", "p3"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
